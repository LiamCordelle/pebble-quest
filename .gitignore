build/
node_modules/
.waf-*
.lock-waf*
.DS_Store
*.pyc
__pycache__/
.pebble-logs.pid

# Shared runtime evidence: retain summaries/images, keep local recovery state private.
shots/emulator-smoke/*
!shots/emulator-smoke/result.json
!shots/emulator-smoke/face.png
!shots/emulator-smoke/detail.png
!shots/emulator-smoke/timeout.png
!shots/emulator-smoke/fresh-default.png

# Timezone runtime evidence; keep disposable SDK state and logs local.
shots/emulator-timezones/*
!shots/emulator-timezones/result.json
!shots/emulator-timezones/fresh-default.png
!shots/emulator-timezones/clock-*.png
shots/emulator-timezones/*-expected*.png

# Published-artifact runtime evidence; keep recovery state private.
shots/emulator-publication/*
!shots/emulator-publication/result.json
!shots/emulator-publication/fresh-default.png
!shots/emulator-publication/clock-289-24.png
